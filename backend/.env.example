PORT=4000
JWT_SECRET=replace-with-long-random-secret
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Choose one Firebase credential option:
# 1) JSON content in one env var (best for cloud deployment)
FIREBASE_SERVICE_ACCOUNT_JSON=

# 2) Split env vars (recommended for Render)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n in this value; code converts it to real newlines.
FIREBASE_PRIVATE_KEY=

# 3) Path to local service account file (optional local fallback)
# FIREBASE_SERVICE_ACCOUNT_PATH=./pageturner-c5be1-firebase-adminsdk-fbsvc-4b43bbd046.json
